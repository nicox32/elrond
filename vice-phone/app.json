{
  "expo": {
    "name": "NeonCell",
    "slug": "neoncell",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "neoncell",
    "android": {
      "package": "com.nicox32.neoncell",
      "adaptiveIcon": {
        "backgroundColor": "#14082B",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "ios": {
      "bundleIdentifier": "com.nicox32.neoncell"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "NeonCell",
      "themeColor": "#14082B",
      "backgroundColor": "#14082B"
    },
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#14082B"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "NeonCell utilise l’appareil photo pour prendre des photos avec les filtres de Port Corail.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "NeonCell enregistre vos photos filtrées dans la galerie.",
          "savePhotosPermission": "NeonCell enregistre vos photos filtrées dans la galerie.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF3D8B"
        }
      ]
    ]
  }
}
