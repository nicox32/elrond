{
  "expo": {
    "name": "Elrond",
    "slug": "elrond",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicox32.elrond"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nicox32.elrond"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Elrond",
      "shortName": "Elrond",
      "themeColor": "#0E0F13",
      "backgroundColor": "#0E0F13"
    },
    "scheme": "elrond",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Elrond utilise Face ID pour déverrouiller ton compte et confirmer tes virements."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/elrond"
    }
  }
}
