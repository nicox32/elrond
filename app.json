{
  "expo": {
    "name": "Orvia",
    "slug": "orvia",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nicox32.orvia"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0E0F13",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nicox32.orvia"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Orvia",
      "shortName": "Orvia",
      "themeColor": "#0E0F13",
      "backgroundColor": "#0E0F13"
    },
    "scheme": "orvia",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Orvia utilise Face ID pour déverrouiller votre compte et confirmer vos virements."
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/elrond"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E0F13"
    }
  }
}
